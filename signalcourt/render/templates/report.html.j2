<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">
<title>{{ title }} | Signal Court research note</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Montserrat:wght@400;500;600;700&display=swap">
<style>{{ css|safe }}</style>
</head>
<body>
<a class="skip-link" href="#discovery">Skip to research note</a>
<header class="masthead"><div class="masthead-inner">
  <a href="#discovery" class="brand" aria-label="Signal Court research note">
    <svg width="30" height="32" viewBox="0 0 30 32" aria-hidden="true"><path d="M3 24V8l12-6 12 6v16l-12 6z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 21l5-7 4 3 6-8M8 25h15" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
    <span>Signal Court<span class="brand-sub">Every claim goes on trial</span></span>
  </a>
  <div class="edition">RESEARCH NOTE<span>Public filings · Reproducible evidence</span></div>
  <div class="toolbar"><button type="button" data-action="expand">Expand all</button><button class="print-button" type="button" data-action="print">Print / save PDF <span aria-hidden="true">↗</span></button></div>
</div></header>
<div class="page-shell">
<aside class="section-index" aria-label="Report sections"><p class="eyebrow">In this note</p><nav>
  <a href="#discovery" class="active">Discovery</a><a href="#gap">The signal</a><a href="#why">Why it matters</a>
  <a href="#evidence">Evidence</a><a href="#timeline">Timeline</a><a href="#counterargument">Counterargument</a>
  <a href="#falsification">Falsification</a><a href="#strength">Evidence strength</a>
  <a href="#method">Method &amp; audit</a><a href="#ledger">Evidence ledger</a>
</nav><div class="index-foot"><span class="status-dot"></span> Saved research run<p>As of {{ as_of }}</p><p class="mono">{{ run.mode|upper }}</p></div></aside>
<main id="main">
<section class="hero" id="discovery">
  <div class="company-line"><div><p class="eyebrow">{{ subtype }} <span class="slash">/</span> {{ symbol }}</p><h1>{{ title }}</h1></div>
    <div class="grade-box {{ grade|lower|replace(' ', '-') }}"><span class="eyebrow">Evidence strength</span><strong>{{ link(grade, verdict.rid if verdict else none) }}</strong><span>Determined by code</span></div>
  </div>
  <div class="dateline"><span>As of {{ as_of }}</span><span>Run {{ link(run_id, appendix[0].env.rid) }}</span><span>{{ generated }}</span></div>
  <div class="thesis"><span class="eyebrow gold">{% if signal %}The discovery{% else %}Research outcome{% endif %}</span><h2>{{ rich(elements.discovery) }}</h2></div>
  {% if prereg_stub and signal %}<p class="notice"><span class="notice-mark">!</span> The hypothesis and kill test were not pre-registered in this run. This is a detected signal awaiting a tested explanation.</p>{% endif %}
  {% if court_stub and signal %}<p class="court-notice"><span class="tag llm">Court · stub</span> The court ran as a stub in this run: no evidence was argued.</p>{% endif %}
  {% if signal %}<div class="number-strip">{% for tile in tiles %}<div class="number-tile"><p>{{ tile.label }}</p><strong>{{ link(tile.value, signal.rid) }}</strong></div>{% endfor %}</div>{% endif %}
  {% if not signal %}<div class="empty-note"><p>The scan did not retain a qualifying anomaly. No research conclusion is claimed.</p><p>Metrics available: {{ scan.metrics|map('replace','_',' ')|join(', ') or 'No measured metrics' }}.</p><p>Peer universe: {{ link(scan.peers, appendix[0].env.rid) }}. Baseline: {{ scan.baseline }}.</p></div>{% endif %}
</section>
<details class="report-section chart-section" id="gap" open><summary><span><span class="eyebrow">Measured by code</span>The signal in context</span><span class="section-toggle" aria-hidden="true"></span></summary><div class="section-body">
  {% if signal %}{{ chart }}<div class="chart-foot"><span>Baseline construction</span><p>{{ rich({'text':scan.notes,'rids':[signal.rid]}) }}</p></div>{% else %}<p class="muted">There is no retained signal to plot. The metric panel and source records can still be audited.</p>{% endif %}
</div></details>
<details class="report-section" id="why" open><summary><span>Why it matters</span><span class="section-toggle" aria-hidden="true"></span></summary><div class="section-body"><ul class="why-list">{% for item in elements.why %}<li>{{ rich(item) }}</li>{% endfor %}</ul></div></details>
<details class="report-section" id="evidence" open><summary><span>Evidence<span class="summary-note">Follow the filing trail</span></span><span class="section-toggle" aria-hidden="true"></span></summary><div class="section-body">
  {% if evidence_overview %}<div class="evidence-overview">{% for item in evidence_overview %}<p>{{ rich(item) }}</p>{% endfor %}</div>{% endif %}
  {% for family, docs in evidence.items() %}<details class="source-group"{% if docs|length < 4 %} open{% endif %}><summary><span>{{ label(family) }}</span><span class="mono">{{ docs|length }} documents</span></summary><div class="source-list">{% for doc in docs %}<article class="source-card"><div><span class="source-kind">{{ doc.kind }}</span><h4>{{ doc.period }}</h4><p>Published {{ doc.published }}</p><span class="mono source-rid">{{ link(doc.rid, doc.rid) }}</span></div><div class="source-actions">{% if doc.source %}<a href="{{ doc.source }}" target="_blank" rel="noopener noreferrer">Source ↗</a>{% else %}<span class="muted">Source unavailable</span>{% endif %}{% if doc.local %}<a href="{{ doc.local }}" target="_blank" rel="noopener noreferrer">Local copy ↗</a>{% endif %}</div></article>{% endfor %}</div></details>{% else %}<p class="muted">No source documents were recorded.</p>{% endfor %}
  {% for item in court_evidence %}<article class="court-evidence"><p class="eyebrow lilac">{{ item.family }} · {{ item.stance }}</p><p>{{ rich({'text':item.sentence,'rids':[item.rid]}) }}</p>{% if item.quote %}<blockquote>{{ item.quote }}</blockquote><p>{{ link('Exact source passage',item.span_rid) }}</p>{% endif %}{% if item.doc and item.doc.source %}<a href="{{ item.doc.source }}" target="_blank" rel="noopener noreferrer">Source ↗</a>{% endif %}</article>{% endfor %}
</div></details>
<details class="report-section" id="timeline" open><summary><span>Timeline<span class="summary-note">What changed, and when</span></span><span class="section-toggle" aria-hidden="true"></span></summary><div class="section-body"><ol class="timeline">{% for item in timeline %}<li>{{ rich(item) }}</li>{% else %}<li>No dated finding events were recorded. Filing publication dates are shown in the evidence trail.</li>{% endfor %}</ol></div></details>
<details class="report-section" id="numbers" open><summary><span>The numbers<span class="summary-note">Click a figure to inspect its inputs</span></span><span class="section-toggle" aria-hidden="true"></span></summary><div class="section-body"><div class="numbers-list">{% for item in elements.numbers %}<p>{{ rich(item) }}</p>{% else %}<p class="muted">The signal statistics are shown above. No completed finding's numerical summary was saved.</p>{% endfor %}</div></div></details>
<details class="report-section" id="counterargument" open><summary><span>Counterargument<span class="tag llm">Adversarial review</span></span><span class="section-toggle" aria-hidden="true"></span></summary><div class="section-body">
  {% if court_stub %}<p class="notice">The court ran as a stub in this run: no evidence was argued.</p><p class="muted">These explanations still need testing:</p><div class="alternatives">{% for alternative in alternatives %}<span>{{ label(alternative) }}</span>{% endfor %}</div>
  {% elif challenge %}<div class="court-grid"><article><p class="eyebrow lilac">Challenge · {{ challenge.payload.severity }}</p><h3>{{ label(challenge.payload.alt_type) }}</h3><p>{{ rich({'text':challenge.payload.argument,'rids':[challenge.rid]+challenge.payload.evidence+challenge.payload.calc}) }}</p></article><article><p class="eyebrow lilac">Rebuttal</p>{% if rebuttal %}<p>{{ rich({'text':rebuttal.payload.argument,'rids':[rebuttal.rid]+rebuttal.payload.evidence+rebuttal.payload.calc}) }}</p>{% else %}<p>No rebuttal was recorded.</p>{% endif %}<p class="{{ 'pass' if admissibility[0] else 'fail' }}">{{ 'Admissible' if admissibility[0] else 'Unanswered / not admissible' }}</p><p class="muted small">{{ admissibility[1] }}</p></article></div>
  {% else %}<p class="muted">No substantive challenge was recorded for this hypothesis.</p>{% endif %}
  {% if elements.counterargument %}<div class="counter-summary">{{ rich(elements.counterargument) }}</div>{% endif %}
</div></details>
<details class="report-section falsification-section" id="falsification" open><summary><span>What would prove this wrong</span><span class="section-toggle" aria-hidden="true"></span></summary><div class="section-body"><div class="falsification-box"><span class="eyebrow gold">Falsification condition</span><p>{{ rich(elements.falsification) }}</p>{% if not prereg_stub and heads.get('prereg_head') %}<div class="seal"><span class="seal-mark" aria-hidden="true">◇</span><span>Sealed before any evidence was searched<code>{{ heads.prereg_head[1][:12] }}</code></span></div>{% else %}<p class="muted small">No valid pre-registered kill test is available for this run.</p>{% endif %}</div></div></details>
<details class="report-section" id="strength" open><summary><span>Evidence strength</span><span class="section-toggle" aria-hidden="true"></span></summary><div class="section-body"><div class="strength-intro"><strong class="grade-word {{ grade|lower }}">{{ link(grade, verdict.rid if verdict else none) }}</strong><p>Each requirement is checked against the ledger.<br>Confidence is earned through evidence.</p></div>
  {% if checks %}<div class="table-wrap"><table class="check-table"><thead><tr><th scope="col">Check</th><th scope="col">Observed</th><th scope="col">Required</th><th scope="col">Result</th></tr></thead><tbody>{% for name, check in checks.items() %}<tr><th scope="row">{{ label(name) }}</th><td>{{ link(number(check.get('value')),verdict.rid) }}</td><td>{{ link(number(check.get('need')),verdict.rid) }}</td><td class="{{ 'pass' if check.get('pass') else 'fail' }}">{{ 'Pass' if check.get('pass') else 'Fail' }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
  {% if verdict and verdict.payload.reasons %}<ul class="verdict-reasons">{% for reason in verdict.payload.reasons %}<li>{{ rich({'text':reason,'rids':[verdict.rid,signal.rid] if signal else [verdict.rid]}) }}</li>{% endfor %}</ul>{% endif %}<p class="g4"><span class="code-label">CODE JUDGE</span> No model was asked how confident it is.</p>
</div></details>
<details class="report-section" id="kill-list"><summary><span>Kill list<span class="summary-note">Rejected proposals &amp; killed claims</span></span><span class="section-toggle" aria-hidden="true"></span></summary><div class="section-body">{% for item in rejections %}<article class="rejected"><p class="eyebrow fail">{{ item.payload.proposal_type }} · {{ item.payload.failing_gate }}</p><p>{{ link(item.payload.reason,item.rid) }}</p>{% if item.payload.detail %}<pre>{{ item.payload.detail|tojson(indent=2) }}</pre>{% endif %}</article>{% endfor %}{% for item in killed %}<article class="rejected"><h3>{{ link('Killed hypothesis', item.payload.claim_rid) }}</h3>{% for reason in item.payload.reasons %}<p>{{ rich({'text':reason,'rids':[item.rid]}) }}</p>{% endfor %}</article>{% endfor %}{% if not rejections and not killed %}<p class="muted">Nothing was rejected in this run.</p>{% endif %}</div></details>
<details class="report-section" id="other-hypotheses"><summary><span>Other hypotheses tested</span><span class="section-toggle" aria-hidden="true"></span></summary><div class="section-body">{% for other in others %}<article class="other-hypothesis"><div><p class="eyebrow">{{ other.kind }}</p><p>{{ link(other.text,other.rid) }}</p></div><div><span class="tag {{ other.grade|lower }}">{{ other.grade }}</span><p class="small muted">Surprise {{ link(number(other.score),other.signal_rid) }}</p></div></article>{% else %}<p class="muted">No additional hypotheses were retained.</p>{% endfor %}</div></details>
<details class="report-section" id="method"><summary><span>How this was produced<span class="summary-note">Method &amp; reproducibility</span></span><span class="section-toggle" aria-hidden="true"></span></summary><div class="section-body">
  <p class="muted">Implementation status is recorded for this run. An unknown status means the older run did not save it.</p><div class="stage-grid">{% for stage in stages %}<article data-stage="{{ stage.name }}" data-impl="{{ stage.impl }}"><p class="stage-name">{{ label(stage.name) }}</p><span class="tag {{ 'llm' if stage.kind=='LLM' else 'code' }}">{{ stage.kind }}</span><p class="stage-impl">{{ stage.impl|capitalize }}</p><span class="small muted">{{ stage.records }} records</span></article>{% endfor %}</div>
  <h3>Coverage &amp; limitations</h3><p>{{ scan.metrics|length }} metrics available · {{ scan.peers }} peers in the resolved universe. Available metrics: {{ scan.metrics|map('replace','_',' ')|join(', ') or 'None' }}.</p><p class="muted">The retained signals record their baseline and coverage. Available metrics are not proof that every metric completed scanning.</p>{% for note in notes %}<p class="method-note">{{ note }}</p>{% endfor %}
  {% for stop in stops %}<p class="notice"><strong>{{ link(label(stop.payload.reason),stop.rid) }}</strong> · {{ stop.payload.open_items|join(', ') or 'No open items recorded' }} · {{ link(number(stop.payload.elapsed_s),stop.rid) }} seconds elapsed</p>{% endfor %}
  <h3>Ledger seals</h3>{% for name in ['prereg_head','run_head'] %}<div class="hash-row"><span>{{ name }}</span><code id="hash-{{ name }}">{{ heads[name][1] if name in heads else 'Not sealed' }}</code>{% if name in heads %}<button type="button" class="copy-button" data-copy="hash-{{ name }}">Copy</button>{% endif %}</div>{% endfor %}
  <h3>Run fingerprint</h3><dl class="fingerprint"><dt>Code revision</dt><dd class="mono">{{ run.code_git_sha }}</dd><dt>Settings hash</dt><dd class="mono">{{ run.settings_hash }}</dd><dt>Model pools hash</dt><dd class="mono">{{ run.model_pools_hash }}</dd></dl>
  <details class="record-counts"><summary>Record counts by type</summary><div class="count-grid">{% for kind, count in counts.items() %}<p><span>{{ kind }}</span><strong>{{ count }}</strong></p>{% endfor %}</div></details><p class="verify-command">Re-check this report:<code>signal verify "{{ run_dir }}"</code></p>
</div></details>
<details class="report-section ledger-section" id="ledger"><summary><span>Evidence ledger<span class="summary-note">Click-through record appendix</span></span><span class="section-toggle" aria-hidden="true"></span></summary><div class="section-body"><p class="muted">Every linked figure opens its backing record. Calculations show their formula, inputs, and source trail.</p><label class="ledger-search">Find a record<input id="ledger-search" type="search" placeholder="Search record, metric or formula…" autocomplete="off"></label><div class="table-wrap"><table class="ledger-table"><thead><tr><th scope="col">Record / type</th><th scope="col">Description / formula</th><th scope="col">Value / provenance</th></tr></thead><tbody>{% for row in appendix %}<tr id="{{ row.env.rid }}"><th scope="row"><code>{{ row.env.rid }}</code><span class="record-type">{{ row.env.type.value }}</span></th><td>{{ row.description }}{% if row.inputs %}<p class="record-inputs">Inputs: {% for rid in row.inputs %}{{ link(rid,rid) }} {% endfor %}</p>{% endif %}{% if row.env.type.value=='SPAN' and row.eligible %}<blockquote>{{ row.env.payload.text|replace('STUB','Not implemented') }}</blockquote>{% endif %}</td><td>{% if row.value %}<strong class="mono gold">{{ row.value }}</strong>{% endif %}{% if row.doc %}<p class="small">{{ row.doc.kind }}<br>{{ row.doc.published }}</p>{% if row.doc.source %}<a href="{{ row.doc.source }}" target="_blank" rel="noopener noreferrer">Source ↗</a>{% endif %}{% if row.doc.local %} · <a href="{{ row.doc.local }}" target="_blank" rel="noopener noreferrer">Local copy ↗</a>{% endif %}{% endif %}</td></tr>{% endfor %}</tbody></table></div><p id="ledger-empty" hidden>No records match this search.</p></div></details>
<footer class="report-footer"><span class="footer-brand">Signal Court</span><p>Numbers are computed by code from public filings; text is written from ledger records only. Not investment advice.</p><span>{{ generated }}</span></footer>
</main></div>
<div id="record-popover" role="tooltip" hidden></div><div id="status-message" role="status" aria-live="polite"></div>
<script>{{ js|safe }}</script>
</body></html>
