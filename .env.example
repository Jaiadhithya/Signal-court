# Copy this file to .env in the same folder and paste your keys after the = sign.
# Several keys for one provider: separate them with commas, no spaces.
# Leave a line empty to skip that provider. Never paste this file into a chat or commit it.

# LLM providers. No card anywhere.
MISTRAL_API_KEYS=
NVIDIA_API_KEYS=
GROQ_API_KEYS=
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=
ZAI_API_KEYS=
GITHUB_MODELS_TOKENS=

# Search
TAVILY_API_KEYS=

# Identity strings and workspace. Optional for the day-1 scripts.
JINA_API_KEY=
HTTP_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0 Safari/537.36"
SIGNAL_HOME=./workspace
